@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Pets";
}


<section id="hero" class="position-relative text-light d-flex align-items-start" 
         style="
            background-image: url('@Url.Content("~/images/pets.jpg")');
            background-size: cover;
            background-repeat: no-repeat;
            background-position-x: center;
            background-position-y: 20%;
            min-height: 90vh;
            padding-top: 4rem; /* optional spacing from top */
         ">
    <!-- Overlay for contrast -->
    <div class="overlay position-absolute w-100 h-100" 
         style="background-color: rgba(0, 0, 0, 0.1); top:0; left:0;"></div>

    <div class="container-lg position-relative">
        <div class="row">
            <div class="col-12 col-md-8 text-center text-md-start mb-4 text-dark">
                <!-- BIG Title -->
                <h1 class="display-1 fw-bold" style="line-height: 1.1;">
                    My Pets
                </h1>

                <!-- Description -->
                <p class="lead fs-4 mb-4">
                    Select one of your pets or register a new one!
                </p>
            </div>
        </div>

        <!-- Register Button -->
        <div class="d-flex justify-content-start mb-4">
            <a href="/OwnerPets/Create" 
               class="btn btn-primary btn-lg rounded-pill fw-bold">
                Register a New Pet
            </a>
        </div>

        <!-- Pet Cards -->
        <div id="petsContainer" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <!-- Pet cards will be injected here -->
        </div>

        <div id="loadingMessage" class="text-center fs-5 mt-4">Loading pets… 🐾</div>
    </div>
</section>





@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {

            async function loadPets() {

                const container = document.getElementById("petsContainer");
                const loading = document.getElementById("loadingMessage");

                // Get token and ownerId from localStorage
                const token = localStorage.getItem("jwtToken");
                const ownerId = localStorage.getItem("userOwnerId"); // adjust if stored differently
                if (!token || !ownerId) {
                    loading.textContent = "You are not authenticated or ownerId is missing.";
                    return;
                }

                try {
                    const response = await fetch(`http://localhost:5001/api/owners/${ownerId}/pets`, {
                        headers: {
                            "Authorization": `Bearer ${token}`
                        }
                    });

                    if (!response.ok) {
                        loading.textContent = `Error fetching : ${response.status} ${response.statusText}`;
                        return;
                    }

                    const petsData = await response.json();
                    const pets = petsData.items; // <-- important!

                    if (!pets || pets.length === 0) {
                        loading.textContent = "You have no pets registered yet. 🐾";
                        return;
                    }

                    // Clear loading message
                    loading.style.display = "none";

                    // Render each pet as a Bootstrap card
                    pets.forEach(pet => {
                        const age = pet.birthDate
                            ? Math.floor((new Date() - new Date(pet.birthDate)) / (1000 * 60 * 60 * 24 * 365)) + " years"
                            : "Unknown";

                        const photoUrl = pet.photos && pet.photos.length > 0
                            ? pet.photos[0].url
                            : '/images/catwp/jpg'; // fallback image if no photo

                        const cardHtml = `
                        <div class="col">
                            <div class="compact-horizontal-card">
                                ${photoUrl ? `<img src="${photoUrl}" class="pet-img" alt="${pet.name || "Pet"}">` : ""}
                                <div class="compact-horizontal-card-body">
                                    <div class="pet-info">
                                        <h5 class="fw-bold mb-1">${pet.name || "Unnamed"}</h5>
                                        <p class="mb-0"><strong>Breed:</strong> ${pet.breed || "Unknown"}</p>
                                        <p class="mb-0"><strong>Gender:</strong> ${pet.gender || "Unknown"}</p>
                                        <p class="mb-0"><strong>Type:</strong> ${pet.type || "Unknown"}</p>
                                        <p class="mb-0"><strong>Age:</strong> ${age}</p>
                                    </div>
                                    <div class="pet-buttons mt-2">
                                        <a href="/OwnerPets/Details/${pet.id}" class="btn btn-primary btn-sm rounded-pill">View</a>
                                        <a href="/OwnerPets/Edit/${pet.id}" class="btn btn-outline-secondary btn-sm rounded-pill">Edit</a>
                                        <a href="/OwnerPets/Stay/${pet.id}" class="btn btn-primary btn-sm rounded-pill">Book A Stay</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        `;
                        container.insertAdjacentHTML("beforeend", cardHtml);
                    });

                } catch (err) {
                    loading.textContent = `Error fetching petsss: ${err}`;
                    console.error(err);
                }
            }

            await loadPets();
        })
    </script>
}